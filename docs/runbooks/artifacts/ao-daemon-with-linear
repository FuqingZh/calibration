#!/bin/sh
set -eu

key_file=/home/fqzhang/.config/agent-orchestrator/linear-api-key
if [ ! -r "$key_file" ]; then
  echo "AO Linear credential is not readable: $key_file" >&2
  exit 1
fi

AO_LINEAR_API_KEY=
IFS= read -r AO_LINEAR_API_KEY < "$key_file" || [ -n "$AO_LINEAR_API_KEY" ]
if [ -z "$AO_LINEAR_API_KEY" ]; then
  echo "AO Linear credential is empty: $key_file" >&2
  exit 1
fi

export AO_LINEAR_API_KEY
unset AO_LINEAR_OAUTH_TOKEN
exec /home/fqzhang/.local/bin/ao daemon

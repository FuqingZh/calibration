[Unit]
Description=AO v0.11.1 read-only trusted-LAN Dashboard
After=agent-orchestrator.service network-online.target
Wants=network-online.target

[Service]
Type=forking
ExecStart=/usr/sbin/nginx -c %h/.local/share/ao-dashboard/nginx.conf
ExecReload=/usr/sbin/nginx -c %h/.local/share/ao-dashboard/nginx.conf -s reload
ExecStop=/usr/sbin/nginx -c %h/.local/share/ao-dashboard/nginx.conf -s quit
PIDFile=%h/.local/share/ao-dashboard/nginx.pid
Restart=on-failure
RestartSec=3
UMask=0077

[Install]
WantedBy=default.target

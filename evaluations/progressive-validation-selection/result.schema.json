{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://calibration.example/evaluations/progressive-validation-selection/result.schema.json",
  "title": "Progressive validation selection result",
  "type": "object",
  "required": ["case_id", "model", "reasoning_effort", "codex_exit_code", "elapsed_seconds", "verification", "command_oracle", "final_oracle"],
  "properties": {
    "case_id": {"type": "string", "pattern": "^(P(0[1-9]|10)|H0[1-4])$"},
    "model": {"type": "string", "minLength": 1},
    "reasoning_effort": {"type": "string", "minLength": 1},
    "codex_exit_code": {"type": "integer"},
    "elapsed_seconds": {"type": "number", "minimum": 0},
    "verification": {"$ref": "#/$defs/verification"},
    "command_oracle": {"$ref": "#/$defs/command_oracle"},
    "final_oracle": {"$ref": "#/$defs/final_oracle"}
  },
  "additionalProperties": false,
  "$defs": {
    "verification": {
      "type": "object",
      "required": ["case_id", "passed", "checks", "changed_paths", "unexpected_changes", "missing_required_changes"],
      "properties": {
        "case_id": {"type": "string", "pattern": "^(P(0[1-9]|10)|H0[1-4])$"},
        "passed": {"type": "boolean"},
        "checks": {"type": "array", "items": {"$ref": "#/$defs/post_run_check"}},
        "changed_paths": {"type": "array", "items": {"type": "string"}},
        "unexpected_changes": {"type": "array", "items": {"type": "string"}},
        "missing_required_changes": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": false
    },
    "post_run_check": {
      "type": "object",
      "required": ["phase", "command", "exit_code", "stdout", "stderr"],
      "properties": {
        "phase": {"const": "post_run_verification"},
        "command": {"type": "array", "items": {"type": "string"}},
        "exit_code": {"type": "integer"},
        "stdout": {"type": "string"},
        "stderr": {"type": "string"}
      },
      "additionalProperties": false
    },
    "command_oracle": {
      "type": "object",
      "required": ["enabled", "valid", "observations", "broker_events", "errors"],
      "properties": {
        "enabled": {"type": "boolean"},
        "valid": {"type": "boolean"},
        "observations": {"type": "array", "items": {"$ref": "#/$defs/command_observation"}},
        "broker_events": {"type": "array", "items": {"$ref": "#/$defs/broker_event"}},
        "errors": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": false
    },
    "command_observation": {
      "type": "object",
      "required": ["line", "sequence", "raw_command", "argv", "family", "exit_code"],
      "properties": {
        "line": {"type": "integer", "minimum": 1},
        "sequence": {"type": "integer", "minimum": 0},
        "raw_command": {"type": "string", "minLength": 1},
        "argv": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "family": {"type": "string", "minLength": 1},
        "exit_code": {"type": ["integer", "null"]}
      },
      "additionalProperties": false
    },
    "broker_event": {
      "type": "object",
      "required": ["execution_id", "family", "argv", "argv_sha256", "cwd", "execution_context", "exit_code"],
      "properties": {
        "execution_id": {"type": "integer", "minimum": 1},
        "family": {"type": "string", "minLength": 1},
        "argv": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "argv_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "cwd": {"const": "/workspace"},
        "execution_context": {"const": "executor_sandbox"},
        "exit_code": {"type": "integer"}
      },
      "additionalProperties": false
    },
    "final_oracle": {
      "type": "object",
      "required": ["enabled", "valid", "errors"],
      "properties": {
        "enabled": {"type": "boolean"},
        "valid": {"type": "boolean"},
        "status": {"type": ["string", "null"]},
        "errors": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": false
    },
    "blind_judgment": {
      "type": "object",
      "required": ["judge_id", "scores", "preference", "reason", "critical_failures"],
      "properties": {
        "judge_id": {"type": "string", "minLength": 1},
        "scores": {
          "type": "object",
          "required": ["obligation_reasoning", "check_relevance", "failure_diagnosis", "evidence_honesty", "user_burden"],
          "properties": {
            "obligation_reasoning": {"type": "integer", "minimum": 0, "maximum": 2},
            "check_relevance": {"type": "integer", "minimum": 0, "maximum": 2},
            "failure_diagnosis": {"type": "integer", "minimum": 0, "maximum": 2},
            "evidence_honesty": {"type": "integer", "minimum": 0, "maximum": 2},
            "user_burden": {"type": "integer", "minimum": 0, "maximum": 2}
          },
          "additionalProperties": false
        },
        "preference": {"enum": ["A", "B", "tie"]},
        "reason": {"type": "string", "minLength": 1},
        "critical_failures": {"type": "array", "items": {"enum": ["unsupported_verified_claim", "mandatory_obligation_missed", "forbidden_command_selected", "invented_host_success", "authority_precedence_violation", "generated_artifact_unread", "event_integrity_failure"]}, "uniqueItems": true}
      },
      "additionalProperties": false
    }
  }
}
